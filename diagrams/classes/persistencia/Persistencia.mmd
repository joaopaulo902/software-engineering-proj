%% contratos (esquerda) <- implementações e infraestrutura SQL (direita)
IUnidadeDeTrabalho <|.. UnidadeDeTrabalho
IUnidadeDeTrabalho <|.. UnidadeDeTrabalhoEmMemoria
Transacao <|.. ExecutorPGlite
IFonteInstitucional <|.. FonteInstitucionalEmArquivo
IUsuarioRepository <|.. UsuarioRepository
IProjetoRepository <|.. ProjetoRepository
IVagaRepository <|.. VagaRepository
ICandidaturaRepository <|.. CandidaturaRepository
IParticipacaoRepository <|.. ParticipacaoRepository
IAtividadeRepository <|.. AtividadeRepository
