namespace ImplementacaoSQL {
  class ExecutorSQL {
    <<interface>>
    +query(sql: string, params: unknown [0..*]) Promise~ResultadoSQL~
  }
  class TransacaoPostgres {
    -cliente: PoolClient
    +query(sql: string, params: unknown [0..*]) Promise~ResultadoSQL~
  }
  class ExecutorPGlite {
    -alvo: ConsultaPGlite
    +query(sql: string, params: unknown [0..*]) Promise~ResultadoSQL~
  }
  class UnidadeDeTrabalho {
    -pool: Pool
    +emTransacao(trabalho: Trabalho~T~) Promise~T~
  }
  class UnidadeDeTrabalhoEmMemoria {
    -banco: PGlite
    +emTransacao(trabalho: Trabalho~T~) Promise~T~
  }
  class RepositorioSQL {
    <<abstract>>
    #db: ExecutorSQL
    #executor(tx: Transacao [0..1]) ExecutorSQL
  }
  class UsuarioRepository
  class ProjetoRepository
  class VagaRepository
  class CandidaturaRepository
  class ParticipacaoRepository
  class AtividadeRepository
  class AvaliacaoRepository
  class NotificacaoRepository
  class DenunciaRepository
  class BanimentoRepository
  class PedidoIncorporacaoRepository
  class BaseInstitucionalRepository
  class FonteInstitucionalEmArquivo {
    -caminho: string
    +obterDados() Promise~DadosInstitucionais~
  }
}

%% contratos (esquerda) <- implementações (meio) -> infraestrutura SQL (direita)
IUnidadeDeTrabalho <|.. UnidadeDeTrabalho
IUnidadeDeTrabalho <|.. UnidadeDeTrabalhoEmMemoria
Transacao <|.. TransacaoPostgres
Transacao <|.. ExecutorPGlite
IFonteInstitucional <|.. FonteInstitucionalEmArquivo
IUsuarioRepository <|.. UsuarioRepository
IProjetoRepository <|.. ProjetoRepository
IVagaRepository <|.. VagaRepository
ICandidaturaRepository <|.. CandidaturaRepository
IParticipacaoRepository <|.. ParticipacaoRepository
IAtividadeRepository <|.. AtividadeRepository
IAvaliacaoRepository <|.. AvaliacaoRepository
INotificacaoRepository <|.. NotificacaoRepository
IDenunciaRepository <|.. DenunciaRepository
IBanimentoRepository <|.. BanimentoRepository
IPedidoIncorporacaoRepository <|.. PedidoIncorporacaoRepository
IBaseInstitucionalRepository <|.. BaseInstitucionalRepository
UsuarioRepository --|> RepositorioSQL
ProjetoRepository --|> RepositorioSQL
VagaRepository --|> RepositorioSQL
CandidaturaRepository --|> RepositorioSQL
ParticipacaoRepository --|> RepositorioSQL
AtividadeRepository --|> RepositorioSQL
AvaliacaoRepository --|> RepositorioSQL
NotificacaoRepository --|> RepositorioSQL
DenunciaRepository --|> RepositorioSQL
BanimentoRepository --|> RepositorioSQL
PedidoIncorporacaoRepository --|> RepositorioSQL
BaseInstitucionalRepository --|> RepositorioSQL
UnidadeDeTrabalho ..> TransacaoPostgres : cria
UnidadeDeTrabalhoEmMemoria ..> ExecutorPGlite : cria
TransacaoPostgres ..|> ExecutorSQL
ExecutorPGlite ..|> ExecutorSQL
RepositorioSQL --> "1" ExecutorSQL : db
note for Transacao "Opaca para o domínio: não tem métodos.<br>Os services só repassam a transação aos<br>repositórios, então não conseguem executar<br>SQL (RNF: SQL só no pacote de repositórios)."
note "RepositorioSQL: executor(tx) converte a Transacao recebida<br>em ExecutorSQL; sem tx, usa db (consulta<br>fora de transação). É o único lugar com SQL."
note for UnidadeDeTrabalho "emTransacao abre BEGIN num PoolClient,<br>entrega a TransacaoPostgres ao trabalho<br>e faz COMMIT ou ROLLBACK."
note "CandidaturaRepository: Esquema: UNIQUE (vaga_id, estudante_id)<br>WHERE status <> 'REMOVIDA' (índice parcial).<br>existeNaoRemovida avisa antes de inserir;<br>o índice garante sob concorrência."
