---
title: "Tipos de dados"
config:
  themeCSS: ".relation { display: none; }"
  class:
    hideEmptyMembersBox: true
---
classDiagram
direction TB

namespace Filtros_e_opcoes_de_consulta {
  class FiltroDeVagas {
    <<datatype>>
    +termo: string [0..1]
    +areas: string [0..*]
    +turnos: string [0..*]
    +modalidades: string [0..*]
    +cargaHorariaMaxima: number [0..1] #123;1 a 40#125;
    +ordenarPor: CriterioDeOrdenacao [0..1] = PRAZO
  }
  class CriterioDeOrdenacao {
    <<enumeration>>
    PRAZO
    PUBLICACAO
    CARGA_HORARIA
  }
  class FiltroDeProjetos {
    <<datatype>>
    +termo: string [0..1]
    +areas: string [0..*]
    +somenteComVagasAbertas: boolean [0..1] = false
  }
  class FiltroDeAtividades {
    <<datatype>>
    +termo: string [0..1]
    +areas: string [0..*]
  }
  class FiltroDeCandidaturas {
    <<datatype>>
    +vagaId: number [0..1]
    +status: StatusCandidatura [0..*]
  }
  class FiltroDeUsuarios {
    <<datatype>>
    +termo: string [0..1]
    +papeis: Papel [0..*]
  }
  class Decisao {
    <<enumeration>>
    ACEITAR
    RECUSAR
  }
  class DecisaoIncorporacao {
    <<enumeration>>
    DEFERIDO
    INDEFERIDO
  }
}

namespace Dados_de_entrada {
  class DadosNovaVaga {
    <<datatype>>
    +projetoId: number
    +titulo: string
    +requisitos: string
    +cargaHoraria: number
    +turno: string #123;Manhã, Tarde ou Noite#125;
    +modalidade: string #123;Presencial, Remoto ou Híbrido#125;
    +semestreMinimo: number
    +vagasTotais: number
    +dataEncerramento: Date
    +descricao: string
    +areasTematicas: string [0..*] #123;vazia = área do projeto#125;
    +cursosAceitos: string [0..*] #123;vazia = todos os cursos#125;
    +beneficio: string #123;Horas de extensão ou Bolsa#125;
    +duracaoEmMeses: number [0..1]
  }
  class DadosAtividade {
    <<datatype>>
    +titulo: string
    +descricao: string
    +foto: string [0..1]
  }
  class DadosDenuncia {
    <<datatype>>
    +denunciadoId: number
    +motivo: MotivoDenuncia
    +justificativa: string
    +anexos: string [0..*]
  }
  class PerfilDoUsuario {
    <<datatype>>
    +descricao: string
    +contato: string
    +lattes: string [0..1]
    +linkedin: string [0..1]
    +github: string [0..1]
    +paginaPessoal: string [0..1]
  }
  class DadosDoPerfil {
    <<datatype>>
    +curso: string [0..1] #123;só estudante#125;
    +semestre: number [0..1] #123;só estudante, 1 a 20#125;
  }
  class DadosCadastro {
    <<datatype>>
    +nome: string
    +email: string
    +senha: string
    +papel: Papel #123;ESTUDANTE ou COORDENADOR#125;
    +curso: string [0..1]
    +semestre: number [0..1]
  }
  class DadosInstitucionais {
    <<datatype>>
    +projetos: ProjetoInstitucional [0..*]
    +cursos: string [0..*]
  }
  class ProjetoInstitucional {
    <<datatype>>
    +nome: string
    +descricao: string
    +area: string
    +coordenadorCadastrado: string
  }
  class NovaNotificacao {
    <<datatype>>
    +destinatarioId: number
    +tipo: TipoNotificacao
    +texto: string
    +referenciaId: number [0..1]
  }
}

namespace Itens_de_listagem {
  class VagaComProjeto {
    <<datatype>>
    +vaga: Vaga
    +projetoNome: string
    +projetoArea: string
    +coordenadorNome: string
    +coordenadorId: number
  }
  class CandidaturaComVaga {
    <<datatype>>
    +candidatura: Candidatura
    +vagaTitulo: string
    +projetoId: number
    +projetoNome: string
    +coordenadorNome: string
  }
  class CandidaturaRecebida {
    <<datatype>>
    +candidatura: Candidatura
    +vagaTitulo: string
    +projetoNome: string
    +estudante: Usuario
  }
  class ResumoDeProjeto {
    <<datatype>>
    +projeto: Projeto
    +coordenadorNome: string [0..1]
    +vagasAbertas: number
  }
  class ParticipacaoComProjeto {
    <<datatype>>
    +participacao: Participacao [0..1] #123;vazia = coordenador#125;
    +projetoId: number
    +projetoNome: string
    +projetoArea: string
    +projetoIcone: string [0..1]
    +cargo: string
  }
  class Participante {
    <<datatype>>
    +participacao: Participacao
    +nome: string
  }
  class AtividadeComProjeto {
    <<datatype>>
    +atividade: Atividade
    +projetoNome: string
    +projetoArea: string
    +autorNome: string
  }
  class ResumoDeUsuario {
    <<datatype>>
    +id: number
    +nome: string
    +papel: Papel
    +curso: string [0..1]
    +semestre: number [0..1]
  }
  class BanimentoComUsuario {
    <<datatype>>
    +banimento: Banimento
    +nome: string
    +ultimoProjeto: string [0..1]
  }
  class PedidoComProjeto {
    <<datatype>>
    +pedido: PedidoIncorporacao
    +projeto: Projeto
    +coordenadorNome: string
  }
}

namespace Detalhes_e_resumos {
  class DetalheDaVaga {
    <<datatype>>
    +vaga: VagaComProjeto
    +motivoDeInelegibilidade: string [0..1]
  }
  class DetalheDaCandidatura {
    <<datatype>>
    +candidatura: CandidaturaComVaga
    +historico: HistoricoDeStatus [1..*]
  }
  class DetalheDaCandidaturaRecebida {
    <<datatype>>
    +historico: HistoricoDeStatus [1..*]
  }
  class ContextoDaCandidatura {
    <<datatype>>
    +candidaturaId: number
    +status: StatusCandidatura
    +estudanteId: number
    +estudanteNome: string
    +vagaTitulo: string
    +projeto: Projeto
  }
  class DetalheDoProjeto {
    <<datatype>>
    +projeto: Projeto
    +coordenadorNome: string [0..1]
    +vagas: VagaComProjeto [0..*]
    +atividades: AtividadeComProjeto [0..*]
  }
  class PerfilCompleto {
    <<datatype>>
    +usuario: Usuario
    +ehProprio: boolean
    +emailVisivel: boolean
    +projetos: ParticipacaoComProjeto [0..*]
  }
  class ResumoDaImportacao {
    <<datatype>>
    +projetosNovos: number
    +projetosAtualizados: number
    +cursosNovos: number
    +importadoEm: Date
  }
}

%% Ligações só de layout: empilham os grupos em linhas.
%% Não são relações do modelo; o themeCSS acima as esconde.
FiltroDeUsuarios .. DadosDoPerfil
DadosDoPerfil .. ParticipacaoComProjeto
ParticipacaoComProjeto .. DetalheDoProjeto
PerfilDoUsuario <|-- DadosDoPerfil
CandidaturaRecebida <|-- DetalheDaCandidaturaRecebida
note "Atributos cujo tipo é uma entidade (ex.: +vaga: Vaga) são associações<br>navegáveis do tipo de dado para a entidade, na notação de atributo da UML."
note "Herança (oculta, como todas as linhas): DadosDoPerfil estende PerfilDoUsuario<br>e DetalheDaCandidaturaRecebida estende CandidaturaRecebida; ambos herdam<br>todos os campos do pai. Atributos [0..1] em filtros são opcionais (campo ausente não filtra)."
note "Planejados (ainda não implementados): FiltroDeUsuarios, DadosDenuncia,<br>DadosCadastro, DadosInstitucionais, ProjetoInstitucional, ResumoDeUsuario,<br>BanimentoComUsuario e ResumoDaImportacao. Com as avaliações (Avaliacao),<br>DetalheDoProjeto ganha recomendacoes e PerfilCompleto ganha avaliacoes."
