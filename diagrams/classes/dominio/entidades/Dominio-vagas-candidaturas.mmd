---
title: "Domínio: vagas, candidaturas e projetos"
config:
  class:
    hideEmptyMembersBox: true
---
classDiagram
direction LR

class Usuario {
  <<entity>>
  +id: number
  +nome: string
  +email: string #123;único#125;
  +papel: Papel
  +curso: string [0..1]
  +semestre: number [0..1] #123;semestre atual, 1 a 20#125;
  +perfil: PerfilDoUsuario = PERFIL_VAZIO
  +ativo: boolean = true
  -senhaHash: string
  -tentativasFalhas: number #123;0 a 5#125;
  -bloqueadoAte: Date [0..1]
  +ehEstudante() boolean
  +ehCoordenador() boolean
  +ehAdministrador() boolean
  +semestreAtual() number
  +emailVisivelPara(visitante: Usuario) boolean
  +podeEntrar(agora: Date) boolean
  +registrarFalhaDeLogin(agora: Date) void
  +registrarLoginBemSucedido() void
}
class PerfilDoUsuario {
  <<datatype>>
  +descricao: string #123;até 1000 caracteres#125;
  +contato: string #123;até 200 caracteres#125;
  +lattes: string [0..1] #123;link http ou https, até 300 caracteres#125;
  +linkedin: string [0..1] #123;link http ou https, até 300 caracteres#125;
  +github: string [0..1] #123;link http ou https, até 300 caracteres#125;
  +paginaPessoal: string [0..1] #123;link http ou https, até 300 caracteres#125;
}
class Papel {
  <<enumeration>>
  ESTUDANTE
  COORDENADOR
  ADMIN
}
class Projeto {
  <<entity>>
  +id: number
  +nome: string
  +descricao: string
  +area: string
  +icone: string [0..1]
  +situacao: SituacaoProjeto
  +coordenadorCadastrado: string
  +coordenadorId: number [0..1] #123;definido na incorporação#125;
  +ehCoordenadoPor(usuario: Pick~Usuario, 'id'~) boolean
  +estaIncorporado() boolean
  +aceitaVagas() boolean
}
class SituacaoProjeto {
  <<enumeration>>
  ATIVO
  INATIVO
}
class Vaga {
  <<entity>>
  +id: number
  +projetoId: number
  +titulo: string #123;3 a 100 caracteres#125;
  +requisitos: string #123;1 a 500 caracteres#125;
  +cargaHoraria: number #123;1 a 40 h/semana#125;
  +turno: string #123;Manhã, Tarde ou Noite#125;
  +modalidade: string #123;Presencial, Remoto ou Híbrido#125;
  +semestreMinimo: number #123;1 a 20#125;
  +vagasTotais: number #123;1 a 100#125;
  +vagasRestantes: number #123;0 ≤ vagasRestantes ≤ vagasTotais#125;
  +dataEncerramento: Date #123;dia de calendário#125;
  +descricao: string #123;até 2000 caracteres#125;
  +areasTematicas: string [1..*] #123;vazia na publicação = área do projeto#125;
  +cursosAceitos: string [0..*] #123;vazio = todos#125;
  +beneficio: string #123;Horas de extensão ou Bolsa#125;
  +duracaoEmMeses: number [0..1] #123;1 a 24; vazio = sem prazo#125;
  +publicadaEm: Date
  +nova(dados: DadosNovaVaga) Vaga$
  +temPosicaoDisponivel() boolean
  +prazoAberto(agora: Date) boolean
  +estaAberta(agora: Date) boolean
  +aceitaSemestre(semestre: number) boolean
  +aceitaCurso(curso: string [0..1]) boolean
  +motivoDeInelegibilidade(usuario: Usuario, agora: Date) string [0..1]
}
class Candidatura {
  <<entity>>
  +id: number
  +vagaId: number
  +estudanteId: number
  +/status: StatusCandidatura #123;derivado do estado#125;
  +mensagem: string [0..1] #123;até 500 caracteres#125;
  +criadaEm: Date
  +/motivoDeclinio: string [0..1] #123;lido de motivo#125;
  -estado: EstadoCandidatura
  -motivo: string [0..1] #123;até 500 caracteres#125;
  +aceitar(agora: Date) void
  +recusar(agora: Date) void
  +confirmar(agora: Date) void
  +declinar(motivo: string [0..1], agora: Date) void
  +remover(agora: Date) void
  +ocupaPosicao() boolean
  +estaEmAnalise() boolean
  +historicoNaoGravado() HistoricoDeStatus [0..*]
  +transicionarPara(novo: EstadoCandidatura, agora: Date, observacao: string [0..1] = null) void
  +registrarMotivoDeclinio(motivo: string [0..1]) void
}
class StatusCandidatura {
  <<enumeration>>
  EM_ANALISE
  ACEITA
  RECUSADA
  CONFIRMADA
  DECLINADA
  REMOVIDA
}
class HistoricoDeStatus {
  <<entity>>
  +id: number #123;0 enquanto não gravado#125;
  +candidaturaId: number
  +status: StatusCandidatura
  +ocorridoEm: Date
  +observacao: string [0..1]
}
class Participacao {
  <<entity>>
  +id: number
  +projetoId: number
  +usuarioId: number
  +candidaturaId: number [0..1]
  +cargo: string
  +inicio: Date
  +fim: Date [0..1]
  +previstoAte: Date [0..1] #123;inicio + duracaoEmMeses da vaga#125;
  +mensagemDeSaida: string [0..1]
  +estaAtiva() boolean
  +venceu(agora: Date) boolean
  +encerrar(mensagem: string [0..1], agora: Date) void
}
class Atividade {
  <<entity>>
  +id: number
  +projetoId: number
  +autorId: number
  +titulo: string #123;3 a 100 caracteres#125;
  +descricao: string #123;1 a 2000 caracteres#125;
  +fotoUrl: string [0..1]
  +publicadaEm: Date
}
class Avaliacao {
  <<entity>>
  +id: number
  +participacaoId: number
  +autorId: number
  +tipo: TipoAvaliacao
  +texto: string #123;obrigatório#125;
  +criadaEm: Date
}
class TipoAvaliacao {
  <<enumeration>>
  DO_ESTUDANTE
  DO_PROJETO
}

Projeto "0..*" --> "0..1" Usuario : coordenador
Vaga "0..*" --> "1" Projeto : projeto
Candidatura "0..*" --> "1" Vaga : vaga
Candidatura "0..*" --> "1" Usuario : estudante
Candidatura "1" *--> "0..*" HistoricoDeStatus : -historicoNovo
HistoricoDeStatus "1..*" --> "1" Candidatura : candidatura
Participacao "0..*" --> "1" Projeto : projeto
Participacao "0..*" --> "1" Usuario : participante
Participacao "0..1" --> "0..1" Candidatura : origem
Atividade "0..*" --> "1" Projeto : projeto
Atividade "0..*" --> "1" Usuario : autor
Avaliacao "0..*" --> "1" Participacao : participacao
Avaliacao "0..*" --> "1" Usuario : autor
Usuario ..> Papel
Usuario ..> PerfilDoUsuario
Projeto ..> SituacaoProjeto
Candidatura ..> StatusCandidatura
Avaliacao ..> TipoAvaliacao
note for Candidatura "Só uma candidatura não removida por<br>vaga e estudante: remover (C18) libera<br>uma nova candidatura à mesma vaga.<br>/status é derivado do estado atual<br>(padrão State, página 3). Só a CONFIRMADA<br>ocupa posição: candidatar-se e ser aceito<br>não descontam vagasRestantes.<br>Toda candidatura tem ao menos uma linha de<br>histórico (EM_ANALISE, gravada no C04);<br>historicoNovo guarda só as linhas das<br>transições ainda não gravadas."
note for Participacao "Se a vaga tem duração, previstoAte é definido<br>ao confirmar o ingresso. Planejado: o AgendadorDeTarefas<br>encerrará as participações vencidas e o coordenador<br>será notificado para avaliar o estudante (C08)."
note for Usuario "semestre é o atual, editável no perfil.<br>O e-mail do estudante só é visível para<br>ele, coordenadores e administradores.<br>Planejado (login com senha e cadastro):<br>ativo, senhaHash, tentativasFalhas, bloqueadoAte,<br>podeEntrar e registrar*Login; 5 falhas seguidas<br>bloquearão a conta por 15 minutos (RNF), e o<br>cadastro aberto criará só ESTUDANTE ou<br>COORDENADOR. Hoje o ADMIN e todos os<br>usuários vêm do seed."
note "Os parâmetros agora: Date de Vaga, Candidatura e Participacao têm,<br>no código, o valor padrão new Date#40;#41; (o momento da chamada).<br>Exceção: transicionarPara, que recebe a data de quem a chama."
note "Planejados (ainda não implementados): Avaliacao e TipoAvaliacao<br>(avaliações e recomendações), e os membros de login com senha do Usuario."
