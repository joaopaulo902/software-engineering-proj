            apoio_dominio["<b>erros · calendario · busca</b><br>erros sem HTTP, datas de prazo,<br>busca sem acento"]
        end

        subgraph Persistencia ["Camada de Persistência"]
            direction LR
            Interfaces["<b>interfaces</b><br>a fachada da camada<br>repositórios e unidade de trabalho"]
            Repositorios["<b>repositorios</b><br>único lugar com SQL"]
            infra["<b>infra</b><br>conexão, transação,<br>banco em memória"]
        end

        main -.-> |"&laquo;create&raquo;"| Apresentacao
        main -.-> |"&laquo;create&raquo;"| Dominio
        main -.-> |"&laquo;create&raquo;"| Persistencia
        Apresentacao -.-> |"&laquo;use&raquo;"| Dominio
        controllers -.-> |"&laquo;use&raquo; — só a fachada: tipos de retorno<br>e IUsuarioRepository no SessaoController"| Interfaces
        Dominio -.-> |"&laquo;use&raquo; — somente pela fachada (passo 6)"| Interfaces
        Persistencia -.-> |"&laquo;use&raquo; — monta as entidades"| Entidades
    end

    subgraph Apoio ["Camada de Apoio de Sistema"]
        direction TB
        subgraph postgres ["PostgreSQL"]
            sgbd["<b>sgbd</b><br>&laquo;system&raquo; SGBD relacional<br>Docker, ou PGlite em memória"]
            scripts_db["<b>db</b><br>01-schema.sql · 02-seed.sql"]
        end
        note1["Seta tracejada com ponta aberta = dependência.<br>Não há ciclo: as entidades não dependem de nenhum pacote;<br>a Persistência só as importa para montar os objetos.<br>O Domínio enxerga a Persistência somente pelas interfaces;<br>a Apresentação também usa essas interfaces direto."]
    end

