flowchart LR

    subgraph ClienteWeb ["&laquo;system&raquo; Cliente Web — aplicação React (SPA) no navegador"]
        direction TB
        aplicacao["<b>Aplicacao · rotas · navegacao · contexto</b><br>sessão, tabela de telas e menu de cada papel"]
        paginas["<b>paginas</b><br>telas, uma por componente"]
        componentes["<b>componentes</b><br>estrutura, popups, cards, avisos"]
        servicos_api["<b>servicos-api</b><br>dispara as requisições (fetch);<br>único lugar com os endereços da API"]
    end

    subgraph ServidorAplicacao ["&laquo;system&raquo; Servidor de Aplicação — um único processo Node.js"]
        direction TB

        main["<b>main</b><br>raiz de composição: cria as classes<br>concretas e injeta pelo construtor"]

        subgraph Apresentacao ["Camada de Apresentação"]
            direction LR
            routes["<b>routes</b><br>Express — método + caminho"]
            middlewares["<b>middlewares</b><br>exigirLogin, tratadorDeErros"]
            controllers["<b>controllers</b><br>traduz HTTP para o domínio<br>(com parametros e apresentadores)"]
        end

        subgraph Dominio ["Camada de Domínio"]
            direction LR
            Servicos["<b>servicos</b><br>regras de negócio e controle da transação<br>Vaga · Candidatura · Projeto · Atividade<br>Notificacao · Incorporacao · Usuario"]
            Entidades["<b>entidades</b><br>Usuario · Projeto · Vaga · Candidatura<br>Participacao · Atividade · Notificacao<br>PedidoIncorporacao, com seus comportamentos"]
