{
  "name": "candidatura-extensao",
  "version": "0.1.0",
  "private": true,
  "description": "INF01127 - Etapa 2 - Caso de uso C04: Candidatar-se a Vaga de Extensao",
  "scripts": {
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d",
    "build": "tsc",
    "dev": "tsc && node dist/main.js",
    "dev:memoria": "tsc && cross-env BANCO=memoria node dist/main.js",
    "verificar": "tsc && node dist/verificar.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.14.10",
    "@types/pg": "^8.11.6",
    "cross-env": "^7.0.3",
    "typescript": "^5.5.3"
  }
}
