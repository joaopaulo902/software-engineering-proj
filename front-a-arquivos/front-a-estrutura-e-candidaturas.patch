+    /** POST /candidaturas/:id/declinio (C07, fluxo 2.a) */
+    async declinar(id, motivo) {
+      aoUsar();
+      const r = await doEstudante(id);
+      if (r.status !== 'ACEITA') {
+        throw erro(409, 'Só é possível declinar o ingresso de uma candidatura aceita.');
