+        .filter((r) => r.status !== 'REMOVIDA')
+        .filter((r) => !vagaId || r.vaga.id === Number(vagaId))
+        .filter((r) => status.length === 0 || status.includes(r.status))
+        .sort((a, b) => new Date(b.criadaEm) - new Date(a.criadaEm))
+        .map((r) => paraCoordenador(r));
