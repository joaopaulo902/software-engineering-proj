+.cabecalho__perfil:hover { background: var(--fundo); }
+.cabecalho__quem { display: grid; line-height: 1.25; font-size: 13px; }
+.cabecalho__quem span { color: var(--suave); font-size: 12px; }
+
+.avatar {
+  display: grid; place-items: center; width: 36px; height: 36px; flex-shrink: 0;
+  border-radius: 50%; background: var(--azul-claro); color: var(--azul);
+  font-size: 13px; font-weight: 700;
+}
+.avatar--grande { width: 52px; height: 52px; font-size: 17px; }
+
+/* ----------------------------------------------------------- conteudo */
+.conteudo {
+  width: 100%; max-width: 880px; margin: 0 auto; padding: 24px 28px 64px;
+  display: grid; gap: 16px; align-content: start;
+}
+.conteudo:focus { outline: none; }
+.conteudo > .busca, .conteudo > .filtro { margin-bottom: 0; }
+
+.faixa-exemplo {
+  margin: 0; padding: 9px 28px; background: var(--ambar-claro);
+  border-bottom: 1px solid #fde68a; color: #78350f; font-size: 13px;
+}
+.mensagem-rapida { width: 100%; max-width: 880px; margin: 0 auto; padding: 0 28px; }
+.mensagem-rapida:empty { display: none; }
+.mensagem-rapida .aviso { margin-top: 16px; }
+
+.voltar { justify-self: start; color: var(--suave); font-size: 13.5px; text-decoration: none; }
+.voltar::before { content: "‹ "; }
+.voltar:hover { color: var(--azul); }
+
+.vazio {
+  display: grid; gap: 8px; justify-items: start;
+  padding: 28px; background: #fff; border: 1px dashed var(--borda); border-radius: 12px;
+}
+.vazio h2 { margin: 0; font-size: 18px; }
+.vazio p { margin: 0 0 8px; color: var(--suave); font-size: 14px; max-width: 60ch; }
+.vazio code { font-size: 12.5px; background: var(--fundo); padding: 1px 5px; border-radius: 4px; }
+
+.discreto { color: var(--suave); font-size: 13.5px; }
+.resumo { margin: 0; color: var(--suave); font-size: 13.5px; }
+.resumo:empty { display: none; }
+
+/* ====================================================================
+   CANDIDATURAS (dupla A)
+   ==================================================================== */
+.card--link { display: block; color: inherit; text-decoration: none; }
+.card--link:hover { border-color: #93c5fd; }
+.card__titulo { margin: 0; font-size: 17px; }
+.card > .card__titulo + * { margin-top: 12px; }
+.card > .botao { margin-top: 14px; }
+
+.pessoa { display: flex; align-items: center; gap: 12px; min-width: 0; }
+
+.dados { display: flex; flex-wrap: wrap; gap: 10px 32px; margin: 14px 0 0; }
+.dados dt { color: var(--suave); font-size: 12.5px; }
+.dados dd { margin: 0; font-size: 14px; }
+
+.texto-longo { margin: 0; font-size: 14.5px; max-width: 68ch; white-space: pre-wrap; overflow-wrap: anywhere; }
+.card .discreto { margin: 0; }
+
+/* barra de busca e filtro das listas */
+.filtro { display: grid; gap: 10px; }
+.filtro__linha { display: flex; gap: 10px; }
+.filtro__linha input[type="search"] { flex: 1; min-width: 0; }
+.filtro__linha select { width: auto; max-width: 45%; }
+.filtro__status { display: flex; flex-wrap: wrap; gap: 6px; }
+.chave {
+  padding: 5px 12px; border: 1px solid var(--borda); border-radius: 999px;
+  background: #fff; color: var(--suave); cursor: pointer;
+  font: inherit; font-size: 13px; font-weight: 600;
+}
+.chave:hover { border-color: #cbd5e1; color: var(--tinta); }
+.chave[aria-pressed="true"] { background: var(--tinta); border-color: var(--tinta); color: #fff; }
+
+/* historico do processo: linha do tempo */
+.historico { list-style: none; margin: 0; padding: 0; }
+.historico__passo { position: relative; padding: 0 0 18px 28px; }
+.historico__passo:last-child { padding-bottom: 0; }
+.historico__passo::before {            /* o ponto */
+  content: ""; position: absolute; left: 0; top: 5px; width: 12px; height: 12px;
+  border: 2px solid #94a3b8; border-radius: 50%; background: #fff;
+}
+.historico__passo::after {             /* o traco ate o proximo ponto */
+  content: ""; position: absolute; left: 5px; top: 19px; bottom: -3px; width: 2px; background: var(--borda);
+}
+.historico__passo:last-child::after { display: none; }
+.historico__titulo { display: block; font-size: 14.5px; }
+.historico__quando { color: var(--suave); font-size: 12.5px; }
+.historico__nota { margin: 4px 0 0; color: var(--suave); font-size: 13.5px; max-width: 60ch; }
+
+.historico__passo--atual .historico__titulo { font-weight: 700; }
+.historico__passo--atual::before { border-color: var(--suave); background: var(--suave); }
+.historico__passo--em_analise::before { border-color: var(--ambar); background: var(--ambar); }
+.historico__passo--aceita::before { border-color: var(--azul); background: var(--azul); }
+.historico__passo--confirmada::before { border-color: var(--verde); background: var(--verde); }
+.historico__passo--recusada::before { border-color: var(--vermelho); background: var(--vermelho); }
+
+/* o que da para fazer na candidatura */
+.acoes { display: grid; gap: 12px; padding-top: 4px; }
+.acoes__situacao { margin: 0; color: var(--suave); font-size: 14px; max-width: 68ch; }
+.acoes__situacao:empty { display: none; }
+.acoes__botoes { display: flex; flex-wrap: wrap; gap: 10px; }
+.acoes__botoes:empty { display: none; }
+.acoes__botoes .botao--primario { margin-left: auto; }
+
+/* ====================================================================
+   POPUP (dupla A; serve para todos os popups dos prototipos)
+   ==================================================================== */
+.popup {
+  width: min(520px, calc(100vw - 32px)); max-height: calc(100vh - 32px);
+  padding: 0; border: 0; border-radius: 14px; color: var(--tinta);
+  box-shadow: 0 24px 60px rgba(15, 23, 42, .28);
+}
+.popup::backdrop { background: rgba(15, 23, 42, .45); }
+.popup__caixa { display: grid; gap: 16px; padding: 22px 24px; }
+.popup__topo { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
+.popup__topo h2 { margin: 0; font-size: 19px; }
+.popup__fechar {
+  display: grid; place-items: center; width: 32px; height: 32px; margin: -4px -6px 0 0; flex-shrink: 0;
+  border: 0; border-radius: 8px; background: transparent; color: var(--suave); cursor: pointer;
+}
+.popup__fechar:hover { background: var(--fundo); color: var(--tinta); }
+.popup__fechar svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; }
+.popup__corpo { display: grid; gap: 12px; font-size: 14.5px; }
+.popup__corpo p { margin: 0; }
+.popup .retorno { margin-top: 0; }
+.popup__acoes { display: flex; justify-content: space-between; gap: 10px; }
+
+/* ====================================================================
+   TELAS ESTREITAS: o menu vira gaveta, aberta pelo botao do cabecalho
+   ==================================================================== */
+@media (max-width: 820px) {
+  .estrutura, .estrutura--recolhida { grid-template-columns: minmax(0, 1fr); }
+
+  .menu {
+    position: fixed; z-index: 30; left: 0; top: 0; width: min(var(--menu-largura), 84vw);
+    transform: translateX(-100%); transition: transform .18s ease;
+  }
+  .estrutura--menu-aberto .menu { transform: none; }
+  .estrutura--menu-aberto .menu__fundo {
+    display: block; position: fixed; inset: 0; z-index: 20; background: rgba(15, 23, 42, .45);
+  }
+  /* na gaveta o menu aparece sempre completo, mesmo se estava recolhido */
+  .estrutura--recolhida .menu__marca { display: inline; }
+  .estrutura--recolhida .menu__rotulo { display: inline; }
+  .estrutura--recolhida .menu__item { justify-content: flex-start; padding: 10px 12px; }
+
+  .cabecalho { padding: 0 16px; }
+  .cabecalho__menu { display: grid; }
+  .cabecalho__quem { display: none; }
+  .cabecalho__titulo { font-size: 18px; }
+  .conteudo { padding: 16px 16px 48px; }
+  .mensagem-rapida, .faixa-exemplo { padding-left: 16px; padding-right: 16px; }
+
+  .busca, .filtro__linha { flex-wrap: wrap; }
+  .filtro__linha select { max-width: none; flex: 1; }
+  .card__acao { flex-direction: column; align-items: stretch; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .menu { transition: none; }
+}
