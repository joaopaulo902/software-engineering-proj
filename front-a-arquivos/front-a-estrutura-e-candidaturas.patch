@@ -0,0 +1,87 @@
+// Tela "Vagas abertas": C01 (consultar e filtrar) e o botao do C04 (candidatar-se).
+// Tela da frente C. Aqui ela foi so trazida do antigo paginas.js para o arquivo
+// dela. A unica novidade e o link "Acompanhar esta candidatura" depois do C04.
+
+import { api } from '../servicos-api.js';
+import { aviso } from '../componentes/base.js';
+import { cardDeVaga } from '../componentes/vaga.js';
+
+export async function mostrar(conteudo) {
+  conteudo.innerHTML = `
+    <form class="busca" id="formBusca">
+      <input type="search" id="termo" placeholder="Buscar por título, requisito ou projeto">
+      <select id="area">
+        <option value="">Todas as áreas</option>
+        <option value="Educação">Educação</option>
+        <option value="Saúde">Saúde</option>
+        <option value="Dados">Dados</option>
+      </select>
+      <button class="botao" type="submit">Filtrar</button>
+    </form>
+    <div id="listaVagas" class="lista"></div>`;
+
+  conteudo.querySelector('#formBusca').addEventListener('submit', (evento) => {
+    evento.preventDefault();
+    carregarVagas(conteudo);
+  });
+
+  await carregarVagas(conteudo);
+}
+
+async function carregarVagas(conteudo) {
+  const lista = conteudo.querySelector('#listaVagas');
+  lista.innerHTML = '<p class="carregando">Carregando…</p>';
+
+  const termo = conteudo.querySelector('#termo').value.trim();
+  const area = conteudo.querySelector('#area').value;
+
+  try {
+    const vagas = await api.listarVagas(termo, area);
+
+    lista.innerHTML = vagas.length
+      ? vagas.map(cardDeVaga).join('')
+      : aviso('Nenhuma vaga encontrada com esses filtros.', 'info');
+
+    lista.querySelectorAll('[data-candidatar]').forEach((botao) => {
+      botao.addEventListener('click', () => candidatar(Number(botao.dataset.candidatar), botao));
+    });
+  } catch (erro) {
+    lista.innerHTML = aviso(erro.message, 'erro');
+  }
+}
+
+/** C04 - Candidatar-se a Vaga de Extensao */
+async function candidatar(vagaId, botao) {
+  const card = botao.closest('.card');
+  const retorno = card.querySelector('[data-retorno]');
+  const mensagem = card.querySelector('.mensagem').value;
+
+  botao.disabled = true;
+  botao.textContent = 'Enviando…';
+  retorno.innerHTML = '';
+
+  try {
+    const criada = await api.candidatar(vagaId, mensagem);
+
+    retorno.innerHTML =
+      aviso(
+        `Candidatura #${criada.id} enviada. Status: Em análise. ` +
+          'O coordenador do projeto foi notificado.',
+        'sucesso'
+      ) +
+      `<a class="botao botao--texto" href="#/candidaturas/${criada.id}">Acompanhar esta candidatura</a>`;
+    botao.textContent = 'Candidatura enviada';
+    card.querySelector('.mensagem').disabled = true;
+
+    // A vaga perdeu uma posicao. Atualizamos o contador no lugar, sem
+    // recarregar a lista, para a mensagem de retorno continuar na tela.
+    const contador = card.querySelector('.contador');
+    const [restantes, totais] = contador.textContent.trim().split(' de ').map(Number);
+    contador.textContent = `${restantes - 1} de ${totais}`;
+    if (restantes - 1 === 0) contador.classList.add('contador--zero');
+  } catch (erro) {
+    retorno.innerHTML = aviso(erro.message, 'erro');
+    botao.disabled = false;
+    botao.textContent = 'Candidatar-se';
+  }
+}
diff --git a/public/js/principal.js b/public/js/principal.js
new file mode 100644
index 0000000..828e72a
--- /dev/null
+++ b/public/js/principal.js
@@ -0,0 +1,118 @@
+// Ponto de partida do Cliente Web. Faz so tres coisas: descobre quem esta
+// logado, monta a estrutura comum e entrega cada endereco a tela dele.
+// O conteudo das telas fica em `paginas/`, um arquivo por tela.
+
+import { MENU, ROTA_INICIAL } from './rotas.js';
+import { navegar, enderecoAtual, acharRota, ouvirNavegacao } from './navegacao.js';
+import { usuarioAtual, restaurarSessao, sair, esquecerSessao } from './sessao.js';
+import {
+  montarEstrutura,
+  prepararTela,
+  definirTitulo,
+  definirContadorDoSino
+} from './componentes/estrutura.js';
+import { api } from './servicos-api.js';
+import { aviso, carregando } from './componentes/base.js';
+import { mostrarEntrada } from './paginas/entrada.js';
+
+const app = document.getElementById('app');
+let estruturaDe = null; // id do usuario para quem a estrutura esta montada
+
+function telaDeEntrada() {
+  estruturaDe = null;
+  document.title = 'Connext — Extensão INF';
+  mostrarEntrada(app, {
+    aoEntrar: () => {
+      if (enderecoAtual().caminho === '/') navegar(ROTA_INICIAL);
+      else mostrarTela();
+    }
+  });
+}
+
+async function mostrarTela() {
+  const usuario = usuarioAtual();
+  if (!usuario) {
+    telaDeEntrada();
+    return;
+  }
+
+  const { caminho, consulta } = enderecoAtual();
+  if (caminho === '/') {
+    navegar(ROTA_INICIAL);
+    return;
+  }
+
+  if (estruturaDe !== usuario.id) {
+    montarEstrutura(app, {
+      usuario,
+      itens: MENU[usuario.papel] ?? [],
+      aoSair: async () => {
+        await sair();
+        history.replaceState(null, '', location.pathname);
+        telaDeEntrada();
+      }
+    });
+    estruturaDe = usuario.id;
+  }
+
+  atualizarSino();
+
+  const achada = acharRota(caminho);
+
+  if (!achada) {
+    const conteudo = prepararTela({ titulo: 'Tela não encontrada', itemDoMenu: null });
+    conteudo.innerHTML = aviso('Este endereço não leva a nenhuma tela. Use o menu ao lado.', 'info');
+    return;
+  }
+
+  const { rota, params } = achada;
+  const conteudo = prepararTela({ titulo: rota.titulo, itemDoMenu: rota.menu ?? rota.caminho });
+
+  if (rota.papeis && !rota.papeis.includes(usuario.papel)) {
+    conteudo.innerHTML = aviso('Esta tela não está disponível para o seu perfil.', 'info');
+    return;
+  }
+
+  conteudo.innerHTML = carregando();
+
+  try {
+    const pagina = await rota.pagina();
+    await pagina.mostrar(conteudo, {
+      usuario,
+      params,
+      consulta,
+      rota,
+      definirTitulo: (titulo) => {
+        // So vale enquanto esta tela ainda e a que esta na pagina.
+        if (conteudo.isConnected) definirTitulo(titulo);
+      },
+      recarregar: mostrarTela
+    });
+  } catch (erro) {
+    if (erro.status === 401) {
+      // A sessao expirou no servidor (ele foi reiniciado, por exemplo).
+      esquecerSessao();
+      telaDeEntrada();
+      return;
+    }
+    conteudo.innerHTML = aviso(erro.message || 'Não foi possível abrir esta tela.', 'erro');
+  }
+}
+
+/**
+ * O contador do sino e atualizado a cada troca de tela. Falha aqui nao
+ * atrapalha a tela: o sino so fica como estava.
+ */
+async function atualizarSino() {
+  try {
+    definirContadorDoSino(await api.notificacoesNaoLidas());
+  } catch {
+    // Sem rota ou sem sessao: o contador continua como estava.
+  }
+}
+
+(async function iniciar() {
+  await restaurarSessao();
+  ouvirNavegacao(mostrarTela);
+  await mostrarTela();
+})();
