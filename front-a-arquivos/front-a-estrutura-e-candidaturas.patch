+
+/* ====================================================================
+   ESTRUTURA COMUM DAS TELAS (dupla A)
+   Menu lateral + cabecalho + area de conteudo, como nos prototipos.
+   ==================================================================== */
+.estrutura {
+  display: grid; grid-template-columns: var(--menu-largura) minmax(0, 1fr);
+  min-height: 100vh;
+}
+.estrutura--recolhida { grid-template-columns: var(--menu-recolhido) minmax(0, 1fr); }
+
+.pular {
+  position: absolute; left: 8px; top: -60px; z-index: 50;
+  padding: 10px 14px; border: 0; border-radius: 8px;
+  background: var(--azul); color: #fff; font: inherit; font-weight: 600;
+}
+.pular:focus { top: 8px; }
+
+.icone {
+  width: 20px; height: 20px; flex-shrink: 0;
+  fill: none; stroke: currentColor; stroke-width: 1.8;
+  stroke-linecap: round; stroke-linejoin: round;
+}
+
+/* --------------------------------------------------------------- menu */
+.menu {
+  position: sticky; top: 0; height: 100vh; overflow-y: auto;
+  display: flex; flex-direction: column; gap: 6px;
+  padding: 12px; background: var(--menu); color: var(--menu-texto);
+}
+.menu__topo { display: flex; align-items: center; gap: 10px; height: 40px; margin-bottom: 14px; }
+.menu__marca { color: #fff; font-size: 19px; font-weight: 700; letter-spacing: -0.02em; }
+.menu__botao {
+  display: grid; place-items: center; width: 44px; height: 40px; flex-shrink: 0;
+  border: 0; border-radius: 8px; background: transparent; color: inherit; cursor: pointer;
+}
+.menu__botao:hover { background: rgba(255, 255, 255, .08); color: #fff; }
+
+.menu__itens { display: grid; gap: 2px; }
+.menu__pe { display: grid; gap: 2px; margin-top: auto; padding-top: 12px; border-top: 1px solid rgba(255, 255, 255, .12); }
+
+.menu__item {
+  display: flex; align-items: center; gap: 12px; width: 100%;
+  padding: 10px 12px; border: 0; border-radius: 8px;
+  background: transparent; color: inherit; cursor: pointer;
+  font: inherit; font-size: 14px; font-weight: 500; text-align: left; text-decoration: none;
+}
+.menu__item:hover { background: rgba(255, 255, 255, .08); color: #fff; }
+.menu__item[aria-current="page"] { background: var(--azul); color: #fff; }
+.menu__rotulo { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
